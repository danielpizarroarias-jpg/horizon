<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}

  {{ content_for_header }}

  <!-- CONFIGURACIÓN PERSONALIZADA: MOTOR 3D Y GIF -->
  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

  <style>
    /* VARIABLES DE USUARIO - PON TUS LINKS AQUÍ */
    :root {
      --url-mi-gif: url('PEGA_AQUI_EL_LINK_DE_TU_GIF');
      --url-mi-3d: 'PEGA_AQUI_EL_LINK_DE_TU_ARCHIVO_3D.glb';
    }

    /* FONDO GIF PARA EL HEADER (HORIZON) */
    .site-header, 
    .header-container, 
    header[role="banner"], 
    .header-sticky-wrapper {
      background-image: var(--url-mi-gif) !important;
      background-size: cover !important;
      background-position: center !important;
      background-repeat: no-repeat !important;
    }

    /* ELIMINAR BLOQUEOS DE COLOR EN HEADER */
    .site-header__wrapper, .site-header {
      background-color: transparent !important;
      background: transparent !important;
    }

    /* ICONO 3D FLOTANTE */
    .contenedor-personalizado-3d {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 10000;
      pointer-events: none; /* No estorba clics */
    }

    #icono-3d-giro {
      width: 130px;
      height: 130px;
      outline: none;
      --poster-color: transparent;
    }

    /* AJUSTE PARA MÓVILES */
    @media screen and (max-width: 749px) {
      #icono-3d-giro {
        width: 80px;
        height: 80px;
      }
      .contenedor-personalizado-3d {
        top: 10px;
        right: 10px;
      }
    }

    /* MEJORA DE VISIBILIDAD DEL MENÚ SOBRE EL GIF */
    .site-nav__link, .site-header__logo-link, .site-header__icon {
      color: #ffffff !important; 
      text-shadow: 1px 1px 3px rgba(0,0,0,0.8) !important;
    }
  </style>
</head>

<body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">

  <!-- COMPONENTE 3D -->
  <div class="contenedor-personalizado-3d">
    <model-viewer 
      id="icono-3d-giro"
      src="PEGA_AQUI_EL_LINK_DE_TU_ARCHIVO_3D.glb" 
      autoplay 
      auto-rotate 
      rotation-speed="40deg"
      interaction-prompt="none"
      disable-zoom>
    </model-viewer>
  </div>

  <div class="page-container" id="PageContainer">
    {% section 'header' %}

    <main class="main-content" id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
  </div>

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'general.accessibility.refresh_page' | t }}</li>
  </ul>

  <!-- SCRIPTS NATIVOS DEL TEMA -->
  {{ 'theme.js' | asset_url | script_tag }}

</body>
</html>